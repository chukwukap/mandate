NODE_ENV=development
DATABASE_URL=postgresql://mandate_worker:change-me@127.0.0.1:5432/mandate
APP_ORIGIN=http://localhost:3000
BASE_RPC_URL=https://base-rpc.publicnode.com
LOG_LEVEL=info

# Start in observation mode. No signer is loaded when this is 0.
WORKER_EXECUTE=0
# Match the public SPENDER_ADDRESS configured in the API.
SPENDER_ADDRESS=
# Worker only: keep this out of the API and browser environments.
WORKER_PRIVATE_KEY=
# Match the API's explicit eligible-country configuration.
ELIGIBLE_COUNTRIES=

WORKER_POLL_MS=2000
WORKER_MAX_BATCH=10
WORKER_CONFIRMATIONS=3
WORKER_RECEIPT_TIMEOUT_MS=1800000
