{
  "name": "mandate-node",
  "private": true,
  "type": "module",
  "version": "0.0.0",
  "engines": {
    "node": ">=24 <27",
    "bun": ">=1.3.9"
  },
  "packageManager": "bun@1.3.9",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "lint": "biome check .",
    "format": "biome format --write .",
    "dev:api": "node --env-file-if-exists=.env --import tsx --watch apps/api/src/main.ts",
    "build:api": "bun scripts/dev/build-api.ts",
    "start:api": "node --env-file-if-exists=.env apps/api/dist/main.js",
    "typecheck": "tsc --noEmit",
    "test:api": "bun test apps/api/test packages/auth/test packages/database/test packages/evm/test packages/strategy/test",
    "db:generate": "node packages/database/node_modules/drizzle-kit/bin.cjs generate --config packages/database/drizzle.config.ts",
    "db:migrate": "node --env-file-if-exists=.env --import tsx scripts/database/migrate.ts",
    "dev:worker": "node --env-file-if-exists=.env.worker --import tsx --watch apps/worker/src/main.ts",
    "build:worker": "bun scripts/dev/build-worker.ts",
    "start:worker": "node --env-file-if-exists=.env.worker apps/worker/dist/main.js",
    "test:worker": "bun test apps/worker/test packages/execution/test",
    "worker:inspect": "node --env-file-if-exists=.env.worker --import tsx scripts/dev/inspect-worker.ts",
    "dev:web": "node apps/web/node_modules/next/dist/bin/next dev apps/web",
    "build:web": "node apps/web/node_modules/next/dist/bin/next build apps/web",
    "start:web": "node apps/web/node_modules/next/dist/bin/next start apps/web",
    "test:web": "bun test apps/web/test/unit",
    "test:web:browser": "node apps/web/test/browser/smoke.mjs",
    "check:structure": "bun scripts/dev/audit-structure.ts",
    "check:structure:web": "bun scripts/dev/audit-structure.ts apps/web --strict"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.12",
    "@electric-sql/pglite": "0.5.8",
    "@types/bun": "1.4.1",
    "@types/node": "26.4.1",
    "drizzle-orm": "0.45.2",
    "railway": "3.11.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2",
    "zod": "4.5.4"
  }
}
