NODE_ENV=development
HOST=127.0.0.1
PORT=8080
APP_ORIGIN=http://localhost:3000
DATABASE_URL=postgres://mandate:mandate@localhost:55432/mandate
# Separate owner role; used only by the explicit migration command.
MIGRATION_DATABASE_URL=
BASE_RPC_URL=https://mainnet.base.org
# Public worker spender address; API does not require signing keys.
SPENDER_ADDRESS=
# Explicit country allowlist reviewed for your product; empty disables trading.
ELIGIBLE_COUNTRIES=
# Only enable behind a proxy that overwrites cf-ipcountry and blocks direct access.
TRUSTED_PROXY_IPS=
# Optional local-only manual demo eligibility; ignored in production.
DEV_COUNTRY=

# Privy server authentication.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Public frontend app ID must match the backend app ID. Never expose the secret.
NEXT_PUBLIC_PRIVY_APP_ID=

API_DOCS=1


# Plain-English strategy authoring. Set ONE key and it turns on; models are defaulted per
# provider. AI_PROVIDER only matters when several keys are set and one has to win.
#
# OPENAI_BASE_URL points the OpenAI adapter at any host that speaks chat-completions —
# Groq, Together, OpenRouter, DeepSeek, Fireworks, or a local Ollama — so one adapter covers
# most of the market.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_API_KEY=
# AI_PROVIDER=anthropic
# ANTHROPIC_MODEL=   # default claude-sonnet-5
# OPENAI_MODEL=      # default gpt-5
# OPENAI_BASE_URL=   # e.g. https://api.groq.com/openai/v1
# GOOGLE_MODEL=      # default gemini-2.5-pro
